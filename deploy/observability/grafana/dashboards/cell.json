{
  "uid": "relayna-cell",
  "title": "Relayna Cell",
  "description": "Activity, execution outcomes and enforcement from the Loki audit projection. Integration-test traffic and expected restriction failures are included. CPU/memory utilization and live-state gauges require separate telemetry.",
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "tags": [
    "relayna-cell"
  ],
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "15s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "links": [
    {
      "title": "Overview",
      "type": "link",
      "url": "/d/relayna-cell/relayna-cell",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    },
    {
      "title": "Investigate a Cell",
      "type": "link",
      "url": "/d/relayna-cell-audit/relayna-cell-investigation",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cell_id",
        "type": "textbox",
        "label": "Cell ID (regex)",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "query": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Cells requested",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "For the selected time range and Cell filter. Counts reflect events received by Loki, not current live state. Distinct Cell IDs with a cell.requested record.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (cell_id) (count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"cell.requested\" | __error__=\"\" [$__range]))) or vector(0)",
          "queryType": "instant",
          "legendFormat": "Cells requested",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 40
        }
      }
    },
    {
      "id": 2,
      "title": "API executions completed",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "For the selected time range and Cell filter. Counts reflect events received by Loki, not current live state. Includes command and file-transfer helper executions that finished or failed.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (event_id) (count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=~\"execution.finished|execution.failed\" | __error__=\"\" [$__range]))) or vector(0)",
          "queryType": "instant",
          "legendFormat": "API executions completed",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#008a8a"
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 40
        }
      }
    },
    {
      "id": 3,
      "title": "API execution success",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "Exit-code-zero executions / all finished or failed API executions. Includes workspace helpers. No value when there are no completed executions.",
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (count(sum by (event_id) (count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"execution.finished\" | json code=\"data.exit_code\" | code=\"0\" | __error__=\"\" [$__range]))) or vector(0)) / (count(sum by (event_id) (count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=~\"execution.finished|execution.failed\" | __error__=\"\" [$__range]))) or vector(0))",
          "queryType": "instant",
          "legendFormat": "API execution success",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "\u2014",
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 40
        }
      }
    },
    {
      "id": 4,
      "title": "Process exec events",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "For the selected time range and Cell filter. Counts reflect events received by Loki, not current live state. Successful exec transitions observed by SecCheck; initial container starts and clone events are separate.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (event_id) (count_over_time({service_name=\"relayna-cell\",source=\"runtime\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"process.exec\" | __error__=\"\" [$__range]))) or vector(0)",
          "queryType": "instant",
          "legendFormat": "Process exec events",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 40
        }
      }
    },
    {
      "id": 5,
      "title": "Network denials",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "For the selected time range and Cell filter. Counts reflect events received by Loki, not current live state. Proxy-denied destinations. Intentional restriction tests are included.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (event_id) (count_over_time({service_name=\"relayna-cell\",source=\"network\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"network.deny\" | __error__=\"\" [$__range]))) or vector(0)",
          "queryType": "instant",
          "legendFormat": "Network denials",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 40
        }
      }
    },
    {
      "id": 6,
      "title": "Audit gap reports",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 3
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "For the selected time range and Cell filter. Counts reflect events received by Loki, not current live state. Zero means no gap reports were received; it does not prove complete coverage.",
      "targets": [
        {
          "refId": "A",
          "expr": "count(sum by (event_id) (count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"audit.gap\" | __error__=\"\" [$__range]))) or vector(0)",
          "queryType": "instant",
          "legendFormat": "Audit gap reports",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "\u2014",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "valueSize": 40
        }
      }
    },
    {
      "id": 10,
      "title": "Audit activity over time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "Events in each displayed interval; the interval adapts to the time range. Missing buckets indicate no matching records, not a service-health guarantee. Runtime activity includes process clones and exits.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (source)(count_over_time({service_name=\"relayna-cell\"} | cell_id=~\"${cell_id:raw}\" | __error__=\"\" | keep source [$__interval]))",
          "queryType": "range",
          "legendFormat": "{{source}}",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 65,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "left",
            "axisLabel": "Events",
            "axisCenteredZero": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "control"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "runtime"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "network"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "workload"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#008a8a"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m",
      "maxDataPoints": 120
    },
    {
      "id": 11,
      "title": "Cell outcomes",
      "type": "piechart",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "State recorded in cell.finished, deduplicated by event ID. Deleted means the Cell was stopped by deletion. Exited describes lifecycle, not necessarily a zero process exit code. Preparation failures have no finished event.",
      "targets": [
        {
          "refId": "A",
          "expr": "count by (state)(sum by (event_id,state) (count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"cell.finished\" | json state=\"data.state\", code=\"data.exit_code\", error=\"data.error\" | __error__=\"\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "exited"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "deleted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "interrupted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        },
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        },
        {
          "id": "rowsToFields",
          "options": {
            "mappings": [
              {
                "fieldName": "state",
                "handlerKey": "field.name"
              },
              {
                "fieldName": "Value #A",
                "handlerKey": "field.value"
              }
            ]
          }
        }
      ]
    },
    {
      "id": 12,
      "title": "API execution outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "Events in each displayed interval; the interval adapts to the time range. Missing buckets indicate no matching records, not a service-health guarantee. Non-zero exits can be expected restriction-test results.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"execution.finished\" | json code=\"data.exit_code\" | code=\"0\" | __error__=\"\" | keep source [$__interval]))",
          "queryType": "range",
          "legendFormat": "Exit 0",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"execution.finished\" | json code=\"data.exit_code\" | code!=\"0\" | __error__=\"\" | keep source [$__interval]))",
          "queryType": "range",
          "legendFormat": "Non-zero exit",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "sum(count_over_time({service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"execution.failed\" | __error__=\"\" | keep source [$__interval]))",
          "queryType": "range",
          "legendFormat": "Execution error",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 65,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "left",
            "axisLabel": "Events",
            "axisCenteredZero": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Exit 0"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Non-zero exit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Execution error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m",
      "maxDataPoints": 120
    },
    {
      "id": 13,
      "title": "Network decisions over time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "Events in each displayed interval; the interval adapts to the time range. Missing buckets indicate no matching records, not a service-health guarantee. Allowed is an authorization decision, not proof of a completed upstream connection.",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"relayna-cell\",source=\"network\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"network.allow\" | __error__=\"\" | keep source [$__interval]))",
          "queryType": "range",
          "legendFormat": "Allowed",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=\"relayna-cell\",source=\"network\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"network.deny\" | __error__=\"\" | keep source [$__interval]))",
          "queryType": "range",
          "legendFormat": "Denied",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code"
        },
