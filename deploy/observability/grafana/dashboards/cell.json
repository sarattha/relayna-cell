    {
      "id": 20,
      "title": "Recent Cell outcomes \u00b7 click a Cell to investigate",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "cell-loki"
      },
      "description": "Latest 100 cell.finished records. Exit code is shown only for the exited state; deletion and timeout defaults are not process success. Outcome is at finish time; later deletion does not rewrite this historical event. Open the Cell link for process and command evidence.",
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"relayna-cell\",source=\"control\"} | cell_id=~\"${cell_id:raw}\" | event_kind=\"cell.finished\" | json state=\"data.state\", code=\"data.exit_code\", error=\"data.error\" | line_format `{\"Cell\":\"{{.cell_id}}\",\"State\":\"{{.state}}\",\"Exit code\":{{if eq .state \"exited\"}}{{.code}}{{else}}null{{end}}}`",
          "queryType": "range",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "cell-loki"
          },
          "editorMode": "code",
          "maxLines": 100,
          "direction": "backward"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": null,
          "color": {
            "mode": "palette-classic"
          },
          "noValue": "\u2014",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 185
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cell"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 335
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "Investigate this Cell",
                    "url": "/d/relayna-cell-audit/relayna-cell-investigation?var-cell_id=${__value.raw}&from=${__from}&to=${__to}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "exited": {
                        "text": "Exited",
                        "color": "green"
                      },
                      "failed": {
                        "text": "Failed",
                        "color": "red"
                      },
                      "deleted": {
                        "text": "Deleted",
                        "color": "blue"
                      },
                      "interrupted": {
                        "text": "Interrupted",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "source": "Line",
            "format": "json",
            "replace": true,
            "keepTime": true
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "Time": 0,
              "Cell": 1,
              "State": 2,
              "Exit code": 3
            }
          }
        }
      ]
    },
