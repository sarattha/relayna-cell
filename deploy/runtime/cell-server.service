[Unit]
Description=Relayna Cell single-host development runtime
Requires=docker.service
After=docker.service
PartOf=docker.service

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=relayna-cell
RuntimeDirectoryMode=0700
ExecStartPre=/bin/bash /opt/relayna-cell/scripts/network-guard.sh
ExecStart=/opt/relayna-cell/bin/cell-server
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
